# Dependencias (NUNCA se suben porque son muy pesadas y se reconstruyen con npm install)
node_modules/
jspm_packages/
web_modules/

# Archivos de entorno y credenciales (SÚPER IMPORTANTE POR SEGURIDAD!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Logs (Archivos de registro de errores de la app y de npm)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Carpetas de compilación o distribución (si usas TypeScript o bundlers)
dist/
build/
out/

# Configuración de editores de código (opcional, pero recomendado)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Archivos del sistema operativo
.DS_Store
Thumbs.db
docker-compose.yml